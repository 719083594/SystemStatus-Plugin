[Unit]
Description=SystemStatus collector (host and Docker status for the QQ bot, local HTTP API)
After=docker.service network-online.target
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/qqbot/system-status/collector.py --config /opt/qqbot/system-status/config.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
